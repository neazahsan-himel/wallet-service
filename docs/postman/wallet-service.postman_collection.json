{
  "info": {
    "name": "Wallet Service (IQD)",
    "description": "Every endpoint and every outcome of the wallet service.\n\nRun the whole collection in order (Collection > Run). Requests depend on each other: Setup creates the wallets, later folders move money between them and check the exact balances.\n\nEvery request name ends with its expected result, e.g. `[201]` or `[422 INSUFFICIENT_FUNDS]`. A collection-level test reads that tag and asserts the HTTP status and the ProblemDetail `code`, so each request needs only its extra checks.\n\nEach run uses a fresh `runId` (set in Setup) as the prefix of every Idempotency-Key, so the collection can be run again without key clashes.\n\nThe last folder, Frozen wallet, needs one manual SQL step first. See its description.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Expected outcome is encoded in the request name: [201] or [422 INSUFFICIENT_FUNDS].",
          "const tag = pm.info.requestName.match(/\\[(\\d{3})(?: ([A-Z_]+))?\\]\\s*$/);",
          "if (tag) {",
          "    pm.test('status is ' + tag[1], () => pm.response.to.have.status(Number(tag[1])));",
          "    if (tag[2]) {",
          "        pm.test('error code is ' + tag[2], () => pm.expect(pm.response.json().code).to.eql(tag[2]));",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088" },
    { "key": "runId", "value": "" },
    { "key": "walletA", "value": "" },
    { "key": "walletB", "value": "" },
    { "key": "walletC", "value": "" },
    { "key": "walletD", "value": "" },
    { "key": "depositId", "value": "" },
    { "key": "transferId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "feeAccount", "value": "00000000-0000-7000-8000-000000000001" },
    { "key": "cashInAccount", "value": "00000000-0000-7000-8000-000000000002" },
    { "key": "unknownWallet", "value": "00000000-0000-7000-8000-0000000000ff" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Creates four wallets. A: main sender, gets 300,000. B: receiver. C: starts empty. D: gets 5,000,001 for the large-fee cases.",
      "item": [
        {
          "name": "Create wallet A [201]",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('runId', String(Date.now()));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('walletA', pm.response.json().id);",
              "pm.test('balance is 0', () => pm.expect(pm.response.json().balance).to.eql(0));",
              "pm.test('currency is IQD', () => pm.expect(pm.response.json().currency).to.eql('IQD'));",
              "pm.test('status is ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));",
              "pm.test('Location header points at the wallet', () => pm.expect(pm.response.headers.get('Location')).to.include(pm.response.json().id));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"ownerId\":\"user-a\"}" },
            "url": "{{baseUrl}}/api/v1/wallets"
          }
        },
        {
          "name": "Create wallet B [201]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('walletB', pm.response.json().id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"ownerId\":\"user-b\"}" },
            "url": "{{baseUrl}}/api/v1/wallets"
          }
        },
        {
          "name": "Create wallet C [201]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('walletC', pm.response.json().id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"ownerId\":\"user-c\"}" },
            "url": "{{baseUrl}}/api/v1/wallets"
          }
        },
        {
          "name": "Create wallet D [201]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('walletD', pm.response.json().id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"ownerId\":\"user-d\"}" },
            "url": "{{baseUrl}}/api/v1/wallets"
          }
        }
      ]
    },
    {
