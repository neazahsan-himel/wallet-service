          "name": "Get wallet A [200]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('id matches', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('walletA')));",
            "pm.test('balance is 0', () => pm.expect(pm.response.json().balance).to.eql(0));"
          ] } } ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/wallets/{{walletA}}" }
        },
        {
          "name": "Get unknown wallet [404 WALLET_NOT_FOUND]",
