          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"ownerId\": " },
            "url": "{{baseUrl}}/api/v1/wallets"
          }
