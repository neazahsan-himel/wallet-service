    {
      "name": "3. Transfers",
      "description": "Fee is 0.5% of the amount, rounded HALF_UP, clamped to [250, 10,000]. The sender pays amount + fee.",
      "item": [
        {
          "name": "Transfer 10,000 A to B, fee 250 [201]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('transferId', pm.response.json().transferId);",
            "pm.test('fee is 250', () => pm.expect(pm.response.json().fee).to.eql(250));",
            "pm.test('totalDebited is 10250', () => pm.expect(pm.response.json().totalDebited).to.eql(10250));",
            "pm.test('senderBalance is 289750', () => pm.expect(pm.response.json().senderBalance).to.eql(289750));"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{runId}}-tr-1" } ],
            "body": { "mode": "raw", "raw": "{\"fromWalletId\":\"{{walletA}}\",\"toWalletId\":\"{{walletB}}\",\"amount\":10000}" },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
        {
          "name": "Retry same transfer, same key: replayed, not doubled [201]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('same transferId as the first call', () => pm.expect(pm.response.json().transferId).to.eql(pm.collectionVariables.get('transferId')));",
            "pm.test('senderBalance is still 289750', () => pm.expect(pm.response.json().senderBalance).to.eql(289750));"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{runId}}-tr-1" } ],
            "body": { "mode": "raw", "raw": "{\"fromWalletId\":\"{{walletA}}\",\"toWalletId\":\"{{walletB}}\",\"amount\":10000}" },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
