    {
      "name": "2. Deposits",
      "item": [
        {
          "name": "Deposit 300,000 into A [201]",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('depositId', pm.response.json().depositId);",
            "pm.test('amount is 300000', () => pm.expect(pm.response.json().amount).to.eql(300000));",
